+        ):
+            scheduler_output.retire_request_tags = scheduled_tags
+        else:
+            scheduler_output.retire_request_tags = {}
+            pending = getattr(self, "_retire_boundary_tags", None)
+            if pending is None:
+                pending = self._retire_boundary_tags = {}
+            # Keep short-step authority local to EngineCore.  Putting it in
+            # SchedulerOutput would serialize an otherwise unused tag map to
+            # every worker on every decode step.
+            pending[id(scheduler_output)] = scheduled_tags
+
+    def _retire_close_boundary_authority(
+        self,
+        scheduler_output: SchedulerOutput,
+        model_output: ModelRunnerOutput,
+    ) -> None:
+        """Reject a stale short step before scheduler/KV/output publication."""
+        tags = getattr(self, "_retire_boundary_tags", {}).pop(
+            id(scheduler_output), {}
+        )
+        if not tags:
+            return
+        from retire_serving.epoch_mailbox import get_frontend_mailbox
+
+        mailbox = get_frontend_mailbox()
+        rejected = {
+            request_id
+            for request_id, (scope_slot, expected_version) in tags.items()
+            if mailbox.read_slot(scope_slot) != expected_version
+        }
+        if rejected:
+            model_output.retire_rejected_request_ids.update(rejected)
+            self._retire_boundary_output_rejections = getattr(
+                self, "_retire_boundary_output_rejections", 0
+            ) + len(rejected)
+
+    def retire_epoch_audit(self) -> dict[str, Any]:
+        """Synchronize and collect kernel/publication counters from workers."""
+        return {
+            "workers": self.collective_rpc("retire_epoch_audit"),
+            "late_admission_rejections": getattr(
+                self, "_retire_late_admission_rejections", 0
+            ),
+            "boundary_output_rejections": getattr(
+                self, "_retire_boundary_output_rejections", 0
+            ),
+        }
+
+    def _retire_group_metadata(self) -> list[dict[str, Any]]:
+        groups = self.scheduler.kv_cache_manager.kv_cache_config.kv_cache_groups
+        return [
+            {
+                "group_id": f"group-{group_id}",
+                "group_index": group_id,
+                "block_size": group.kv_cache_spec.block_size,
+                "layout": type(group.kv_cache_spec).__name__,
+            }
+            for group_id, group in enumerate(groups)
+        ]
+
+    def retire_inspect_topology(self) -> dict[str, Any]:
+        """Return the exact topology used by retirement certificates."""
+        parallel = self.vllm_config.parallel_config
+        return {
+            "tensor_parallel_size": parallel.tensor_parallel_size,
+            "pipeline_parallel_size": parallel.pipeline_parallel_size,
+            "kv_cache_groups": self._retire_group_metadata(),
+            "speculative_mode": "draft-verify" if self.use_spec_decode else "disabled",
+        }
+
+    def retire_cache_snapshot(self) -> dict[str, Any]:
+        """Return allocation state for controlled KV-pressure experiments."""
+        pool = self.scheduler.kv_cache_manager.block_pool
+        blocks = [block for block in pool.blocks if not block.is_null]
+        pin_sets = getattr(self, "_retire_pin_sets", {})
+        pinned_ids = {
+            int(block_id)
+            for groups in pin_sets.values()
+            for group in groups
+            for block_id in group
+        }
+        return {
+            "total_blocks": len(blocks),
+            "free_blocks": pool.get_num_free_blocks(),
+            "referenced_blocks": sum(block.ref_cnt > 0 for block in blocks),
+            "hashed_blocks": sum(block.block_hash is not None for block in blocks),
+            "evictable_cached_blocks": sum(
+                block.ref_cnt == 0 and block.block_hash is not None
+                for block in blocks
+            ),
+            "pinned_blocks": len(pinned_ids),
+        }
+
+    def _retire_distributed_fence(self, sequence: int) -> list[dict[str, Any]]:
+        """Synchronize every model worker and collect a rank-level receipt."""
+        receipts = self.collective_rpc("retire_fence_ack", args=(sequence,))
+        expected = (
+            self.vllm_config.parallel_config.tensor_parallel_size
+            * self.vllm_config.parallel_config.pipeline_parallel_size
+        )
+        if len(receipts) != expected:
+            raise RuntimeError(
+                f"RETIRE expected {expected} worker receipts, got {len(receipts)}"
+            )
+        return receipts
+
+    def retire_fence_and_pin(
+        self,
+        pin_key: str,
+        request_ids: list[str],
+        tenant_id: str = "default",
+        tenant_pin_quota_blocks: int | None = None,
+    ) -> dict[str, Any]:
+        """Fence requests at a distributed safe point and pin complete KV.
+
+        Utility RPCs execute on the EngineCore thread between model steps.
+        The worker collective adds an explicit CUDA-stream acknowledgement
+        from every TP/PP participant. Pins are acquired before abort releases
+        request references, so cached physical blocks cannot be recycled
+        before the successor adopts them.
+        """
+        pin_sets = getattr(self, "_retire_pin_sets", None)
+        if pin_sets is None:
+            pin_sets = self._retire_pin_sets = {}
+        if pin_key in pin_sets:
+            raise ValueError(f"RETIRE pin key already exists: {pin_key}")
+
+        sequence = getattr(self, "_retire_safe_point_sequence", 0) + 1
+        self._retire_safe_point_sequence = sequence
+        worker_receipts = self._retire_distributed_fence(sequence)
+        group_metadata = self._retire_group_metadata()
+        scheduler = self.scheduler
+        manager = scheduler.kv_cache_manager
+        retired_holds = getattr(scheduler, "_retire_rejected_holds", {})
+
+        participants = []
+        for worker in worker_receipts:
+            if not worker.get("writer_drained"):
+                raise RuntimeError(f"RETIRE worker did not drain: {worker}")
+            for group in group_metadata:
+                participants.append(
+                    {
+                        "tensor_parallel_rank": worker["tensor_parallel_rank"],
+                        "pipeline_parallel_rank": worker["pipeline_parallel_rank"],
+                        "kv_group_id": group["group_id"],
+                        "acknowledged": True,
+                        "writer_drained": True,
+                        "speculation_drained": True,
+                        "codec_drained": True,
+                        "transfer_drained": True,
+                        "safe_point_sequence": sequence,
+                        "detail": "worker CUDA stream synchronized after model step",
+                    }
+                )
+
+        sources: dict[str, Any] = {}
+        pinned_group_block_ids = [[] for _ in group_metadata]
+        source_block_hashes: dict[str, Any] = {}
+        for request_id in request_ids:
+            request = scheduler.requests.get(request_id)
+            if request is None or request.is_finished():
+                hold = retired_holds.pop(request_id, None)
+                if hold is not None:
+                    group_ids = hold["group_block_ids"]
+                    physical_group_ids = hold["physical_group_block_ids"]
+                    group_tokens = hold["group_tokens"]
+                    all_resident = bool(hold["all_blocks_resident"])
+                    if len(group_ids) != len(group_metadata):
+                        raise RuntimeError(
+                            "RETIRE retired hold has inconsistent KV groups"
+                        )
+                    if all_resident:
+                        source_block_hashes[request_id] = hold["block_hashes"]
+                        for group_id, selected in enumerate(physical_group_ids):
+                            pinned_group_block_ids[group_id].extend(selected)
+                    pinned_tokens = int(hold["pinned_tokens"])
+                    sources[request_id] = {
+                        "present": True,
+                        "retired_hold": True,
+                        "writer_drained": True,
+                        "all_blocks_resident": all_resident,
+                        "pinned_tokens": pinned_tokens,
+                        "committed_tokens": pinned_tokens,
+                        "group_block_ids": group_ids,
+                        "group_tokens": group_tokens,
+                        "num_computed_tokens": hold["num_computed_tokens"],
+                    }
+                    continue
+                sources[request_id] = {
+                    "present": False,
+                    "writer_drained": True,
+                    "all_blocks_resident": False,
+                    "pinned_tokens": 0,
+                    "committed_tokens": 0,
+                    "group_block_ids": [[] for _ in group_metadata],
+                    "group_tokens": [0 for _ in group_metadata],
+                }
+                continue
+
+            computed_groups, cached_tokens = (
+                manager.coordinator.find_longest_cache_hit(
+                    request.block_hashes,
+                    request.num_tokens - 1,
+                )
+            )
+            if len(computed_groups) != len(group_metadata):
+                raise RuntimeError("RETIRE observed an inconsistent KV-group topology")
+            source_group_blocks = [list(group) for group in computed_groups]
+            source_physical_blocks = [
+                [block for block in group if not block.is_null]
+                for group in source_group_blocks
+            ]
+            source_group_ids = [
+                [block.block_id for block in group]
+                for group in source_group_blocks
+            ]
+            all_resident = (
+                cached_tokens > 0
+                and all(source_group_blocks)
+                and all(source_physical_blocks)
+            )
+            group_tokens = [cached_tokens for _ in group_metadata]
+
+            if all_resident:
+                manager.block_pool.touch(tuple(source_physical_blocks))
+                source_block_hashes[request_id] = request.block_hashes
+                for group_id, selected in enumerate(source_physical_blocks):
+                    pinned_group_block_ids[group_id].extend(
+                        block.block_id for block in selected
+                    )
+            else:
+                source_group_ids = [[] for _ in group_metadata]
+                group_tokens = [0 for _ in group_metadata]
+
+            pinned_tokens = min(group_tokens, default=0)
+            sources[request_id] = {
+                "present": True,
+                "writer_drained": True,
+                "all_blocks_resident": all_resident,
+                "pinned_tokens": pinned_tokens,
+                "committed_tokens": pinned_tokens,
+                "group_block_ids": source_group_ids,
+                "group_tokens": group_tokens,
+                "num_computed_tokens": request.num_computed_tokens,
+            }
+
+        tenant_usage = getattr(self, "_retire_tenant_pinned_blocks", None)
+        if tenant_usage is None:
+            tenant_usage = self._retire_tenant_pinned_blocks = {}
+        pin_tenants = getattr(self, "_retire_pin_tenants", None)
+        if pin_tenants is None:
+            pin_tenants = self._retire_pin_tenants = {}
+        pinned_blocks = sum(map(len, pinned_group_block_ids))
+        current_tenant_blocks = int(tenant_usage.get(tenant_id, 0))
+        quota_exceeded = (
+            tenant_pin_quota_blocks is not None
+            and current_tenant_blocks + pinned_blocks > tenant_pin_quota_blocks
+        )
+        if quota_exceeded:
+            block_ids = [item for group in pinned_group_block_ids for item in group]
+            if block_ids:
+                manager.block_pool.free_blocks(
+                    [manager.block_pool.blocks[item] for item in reversed(block_ids)]
+                )
+            pinned_group_block_ids = [[] for _ in group_metadata]
+            pinned_blocks = 0
+            for source in sources.values():
+                source["all_blocks_resident"] = False
+                source["pinned_tokens"] = 0
+                source["committed_tokens"] = 0
+                source["group_block_ids"] = [[] for _ in group_metadata]
+                source["group_tokens"] = [0 for _ in group_metadata]
+                source["tenant_quota_exceeded"] = True
+        else:
+            tenant_usage[tenant_id] = current_tenant_blocks + pinned_blocks
+        pin_tenants[pin_key] = tenant_id
+
+        self.abort_requests(request_ids)
+        pin_sets[pin_key] = pinned_group_block_ids
+        pin_hashes = getattr(self, "_retire_pin_hashes", None)
+        if pin_hashes is None:
+            pin_hashes = self._retire_pin_hashes = {}
+        pin_hashes[pin_key] = source_block_hashes
+        return {
+            "pin_key": pin_key,
+            "safe_point": True,
+            "safe_point_sequence": sequence,
+            "pinned_blocks": pinned_blocks,
+            "tenant_id": tenant_id,
+            "tenant_pin_quota_blocks": tenant_pin_quota_blocks,
+            "tenant_pinned_blocks": int(tenant_usage.get(tenant_id, 0)),
+            "tenant_quota_exceeded": quota_exceeded,
+            "tensor_parallel_size": (
+                self.vllm_config.parallel_config.tensor_parallel_size
+            ),
+            "pipeline_parallel_size": (
+                self.vllm_config.parallel_config.pipeline_parallel_size
+            ),
+            "kv_cache_groups": group_metadata,
+            "participants": participants,
+            "sources": sources,
+        }
+
+    def retire_trim_pins(
+        self, pin_key: str, source_request_id: str, reuse_tokens: int
+    ) -> dict[str, Any]:
+        """Force a shorter exact reuse boundary and release its guard band."""
+        pin_sets = getattr(self, "_retire_pin_sets", {})
+        current = pin_sets.get(pin_key)
+        if current is None:
+            raise KeyError(f"unknown RETIRE pin key: {pin_key}")
+        hashes = getattr(self, "_retire_pin_hashes", {}).get(pin_key, {}).get(
+            source_request_id
+        )
+        if hashes is None:
+            raise KeyError(f"RETIRE source was not pinned: {source_request_id}")
+        manager = self.scheduler.kv_cache_manager
+        computed_groups, cached_tokens = manager.coordinator.find_longest_cache_hit(
+            hashes, reuse_tokens
+        )
+        if cached_tokens != reuse_tokens:
+            raise RuntimeError(
+                f"RETIRE exact prefix fell out of cache: {cached_tokens} != "
+                f"{reuse_tokens}"
+            )
+        keep_logical_group_block_ids = [
+            [block.block_id for block in group] for group in computed_groups
+        ]
+        keep_physical_group_block_ids = [
+            [block.block_id for block in group if not block.is_null]
+            for group in computed_groups
+        ]
+        if len(current) != len(keep_physical_group_block_ids):
+            raise ValueError("RETIRE trim does not cover every KV-cache group")
+        original_count = sum(map(len, current))
+        target_count = sum(map(len, keep_physical_group_block_ids))
+        if target_count > original_count:
+            raise RuntimeError("RETIRE shorter prefix requires more pinned blocks")
+        retained: list[list[int]] = []
+        released: list[int] = []
+        missing_groups = []
+        for current_group, keep_group in zip(
+            current, keep_physical_group_block_ids, strict=True
+        ):
+            remaining = set(keep_group)
+            for item in current_group:
+                if item in remaining:
+                    remaining.remove(item)
+                else:
+                    released.append(item)
+            missing_groups.append(
+                [manager.block_pool.blocks[item] for item in remaining]
+            )
+            retained.append(list(keep_group))
+        pool = manager.block_pool
+        if any(missing_groups):
+            # An equivalent hash may resolve to a different free cache block
+            # at the shorter hybrid prefix. The EngineCore is still inside
+            # the distributed safe point, so acquire those references before
+            # releasing the superseded physical choices.
+            pool.touch(tuple(missing_groups))
+        if released:
+            retained_ids = {item for group in retained for item in group}
+            pool.evict_blocks(set(released) - retained_ids)
+            pool.free_blocks(
+                [pool.blocks[block_id] for block_id in reversed(released)]
+            )
+            tenant = getattr(self, "_retire_pin_tenants", {}).get(pin_key)
+            usage = getattr(self, "_retire_tenant_pinned_blocks", {})
+            if tenant is not None:
+                usage[tenant] = max(
+                    0,
+                    int(usage.get(tenant, 0))
+                    - (original_count - target_count),
+                )
+        pin_sets[pin_key] = retained
+        return {
+            "kept_blocks": sum(map(len, retained)),
+            "released_blocks": len(released),
+            "kept_group_block_ids": keep_logical_group_block_ids,
+        }
+
+    def retire_expect_request_blocks(
+        self, request_id: str, expected_group_block_ids: list[list[int]]
+    ) -> dict[str, Any]:
+        """Arm a one-shot scheduler-boundary adoption snapshot."""
+        expectations = getattr(self, "_retire_reuse_expectations", None)
+        if expectations is None:
+            expectations = self._retire_reuse_expectations = {}
+        expectations[request_id] = [
+            list(map(int, group)) for group in expected_group_block_ids
+        ]
+        return {"request_id": request_id, "armed": True}
+
+    def retire_cancel_request_expectation(self, request_id: str) -> dict[str, Any]:
+        """Drop verification state for a successor retired before first output."""
+        expected = getattr(self, "_retire_reuse_expectations", {}).pop(
+            request_id, None
+        )
+        snapshot = getattr(self, "_retire_request_block_snapshots", {}).pop(
+            request_id, None
+        )
+        return {
+            "request_id": request_id,
+            "removed": expected is not None or snapshot is not None,
+        }
+
+    def retire_verify_request_blocks(
+        self, request_id: str, expected_group_block_ids: list[list[int]]
+    ) -> dict[str, Any]:
+        """Verify the successor installed every pinned physical group prefix."""
+        request = self.scheduler.requests.get(request_id)
+        snapshot = getattr(self, "_retire_request_block_snapshots", {}).pop(
+            request_id, None
+        )
+        request_present = request is not None and not request.is_finished()
+        if not request_present and snapshot is None:
+            return {
+                "request_present": False,
+                "scheduler_snapshot_present": False,
+                "installed_group_block_ids": [],
+                "same_physical_blocks": False,
+            }
+        manager = self.scheduler.kv_cache_manager
+        if request_present:
+            group_ids = manager.get_block_ids(request_id)
+            num_computed_tokens = request.num_computed_tokens
+        else:
+            group_ids = snapshot["group_block_ids"]
+            num_computed_tokens = int(snapshot["num_computed_tokens"])
+        if len(group_ids) != len(expected_group_block_ids):
+            raise ValueError("RETIRE verify does not cover every KV-cache group")
+        groups = manager.kv_cache_config.kv_cache_groups
+        null_block_id = manager.block_pool.null_block.block_id
+        installed = []
+        group_verifications = []
+        for group_index, (actual, expected, group) in enumerate(
+            zip(group_ids, expected_group_block_ids, groups, strict=True)
+        ):
+            actual_prefix = list(actual[: len(expected)])
+            spec = group.kv_cache_spec
+            live_start = 0
+            layout = type(spec).__name__
+            if layout == "SlidingWindowSpec":
+                skipped_tokens = max(
+                    0,
+                    num_computed_tokens - int(spec.sliding_window) + 1,
+                )
+                live_start = min(
+                    len(expected), skipped_tokens // int(spec.block_size)
+                )
+            elif layout == "ChunkedLocalAttentionSpec":
+                skipped_tokens = (
+                    num_computed_tokens
+                    // int(spec.attention_chunk_size)
+                    * int(spec.attention_chunk_size)
+                )
+                live_start = min(
+                    len(expected), skipped_tokens // int(spec.block_size)
+                )
+            retired_expected = list(expected[:live_start])
+            retired_installed = actual_prefix[:live_start]
+            live_expected = list(expected[live_start:])
+            live_installed = actual_prefix[live_start:]
+            retired_slots_cleared = all(
+                block_id == null_block_id for block_id in retired_installed
+            )
+            same_physical = (
+                len(actual_prefix) == len(expected)
+                and retired_slots_cleared
+                and live_installed == live_expected
+            )
+            installed.append(actual_prefix)
+            group_verifications.append(
+                {
+                    "group_index": group_index,
+                    "layout": layout,
+                    "live_start_block": live_start,
+                    "expected_block_ids": list(expected),
+                    "installed_block_ids": actual_prefix,
+                    "retired_expected_block_ids": retired_expected,
+                    "retired_installed_block_ids": retired_installed,
+                    "live_expected_block_ids": live_expected,
+                    "live_installed_block_ids": live_installed,
+                    "verified_live_physical_block_ids": [
+                        block_id
+                        for block_id in live_expected
+                        if block_id != null_block_id
+                    ],
+                    "retired_slots_cleared": retired_slots_cleared,
+                    "same_physical_blocks": same_physical,
+                }
+            )
+        return {
+            "request_present": request_present,
+            "scheduler_snapshot_present": snapshot is not None,
+            "installed_group_block_ids": installed,
+            "group_verifications": group_verifications,
+            "same_physical_blocks": all(
+                item["same_physical_blocks"] for item in group_verifications
+            ),
+        }
+
+    def retire_snapshot_request_blocks(self, request_id: str) -> dict[str, Any]:
+        """Read one request's logical block ownership between model steps."""
+        request = self.scheduler.requests.get(request_id)
+        if request is None or request.is_finished():
+            return {
+                "request_present": False,
+                "group_block_ids": [],
+                "num_computed_tokens": 0,
+            }
+        group_ids = self.scheduler.kv_cache_manager.get_block_ids(request_id)
+        return {
+            "request_present": True,
+            "group_block_ids": [list(group) for group in group_ids],
+            "num_computed_tokens": request.num_computed_tokens,
+        }
+
+    def retire_digest_blocks(
+        self, group_block_ids: list[list[int]]
+    ) -> dict[str, Any]:
+        """Digest an immutable physical KV prefix on every worker."""
+        import hashlib
+
+        workers = self.collective_rpc(
+            "retire_digest_blocks", args=(group_block_ids,)
+        )
+        aggregate = hashlib.sha256()
+        for item in sorted(
+            workers,
+            key=lambda row: (
+                int(row.get("pipeline_parallel_rank", 0)),
+                int(row.get("tensor_parallel_rank", 0)),
+            ),
+        ):
+            aggregate.update(str(item["kv_sha256"]).encode())
+        return {
+            "workers": workers,
+            "kv_sha256": aggregate.hexdigest(),
+            "digested_bytes": sum(
+                int(item["digested_bytes"]) for item in workers
+            ),
+        }
+
+    def retire_offload_pins(
+        self, pin_key: str, codec: str, destructive: bool = True
+    ) -> dict[str, Any]:
+        """Move pinned KV bytes through a lossless worker-local DRAM codec."""
+        group_block_ids = getattr(self, "_retire_pin_sets", {}).get(pin_key)
+        if group_block_ids is None:
+            raise KeyError(f"unknown RETIRE pin key: {pin_key}")
+        workers = self.collective_rpc(
+            "retire_offload_blocks",
+            args=(pin_key, group_block_ids, codec, destructive),
+        )
+        drained = bool(workers) and all(
+            item.get("operation_drained") for item in workers
+        )
+        return {
+            "codec": codec,
+            "operation_drained": drained,
+            "workers": workers,
+            "raw_bytes": sum(item["raw_bytes"] for item in workers),
+            "encoded_bytes": sum(item["encoded_bytes"] for item in workers),
+        }
+
+    def retire_offload_pins_capacity(
+        self, pin_key: str, codec: str
+    ) -> dict[str, Any]:
+        """Offload one pinned prefix and return its HBM blocks to the pool.
+
+        The worker copy completes before allocator metadata is changed.  The
+        old hash entries are then removed and the transient pin references are
+        released, so later requests may overwrite the physical slots.  Restore
+        therefore allocates fresh slots and publishes their hashes only after
+        the D2H/H2D round trip has passed its integrity check.
+        """
+        pin_sets = getattr(self, "_retire_pin_sets", {})
+        group_block_ids = pin_sets.get(pin_key)
+        if group_block_ids is None:
+            raise KeyError(f"unknown RETIRE pin key: {pin_key}")
+        source_hashes = getattr(self, "_retire_pin_hashes", {}).get(
+            pin_key, {}
+        )
+        if len(source_hashes) != 1:
+            raise RuntimeError(
+                "capacity-reclaiming offload requires one unambiguous source"
+            )
+        manager = self.scheduler.kv_cache_manager
+        groups = manager.kv_cache_config.kv_cache_groups
+        if len(group_block_ids) != len(groups):
+            raise RuntimeError("RETIRE offload does not cover every KV group")
+        if any(
+            type(group.kv_cache_spec).__name__ != "FullAttentionSpec"
+            for group in groups
+        ):
