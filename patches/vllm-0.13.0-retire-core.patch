+                cpu = torch.empty_like(
+                    selected, device="cpu", pin_memory=True
+                )
+                cpu.copy_(selected, non_blocking=True)
+                entries.append(
+                    {
+                        "group_id": item["group_id"],
+                        "layer_name": item["layer_name"],
+                        "block_axis": item["block_axis"],
+                        "physical_ids": item["physical_ids"],
+                        "shape": tuple(cpu.shape),
+                        "dtype": cpu.dtype,
+                        "cpu": cpu,
+                    }
+                )
+                if destructive:
+                    cache.index_fill_(item["block_axis"], ids, 0)
+        stream.synchronize()
+
+        def encode(
+            entry: dict[str, Any],
+        ) -> tuple[bytes | None, str, bytes, int]:
+            raw = memoryview(entry["cpu"].view(torch.uint8).numpy())
+            decoded_digest = hashlib.sha256(raw).digest()
+            encoded = zlib.compress(raw, level=1) if codec == "zlib" else None
+            encoded_digest = (
+                hashlib.sha256(encoded).digest()
+                if codec == "zlib"
+                else decoded_digest
+            )
+            return encoded, decoded_digest.hex(), encoded_digest, raw.nbytes
+
+        workers = min(len(entries), 16, max(1, os.cpu_count() or 1))
+        with ThreadPoolExecutor(max_workers=workers) as executor:
+            encoded_values = list(executor.map(encode, entries))
+        for entry, encoded_value in zip(entries, encoded_values, strict=True):
+            encoded, decoded_sha256, encoded_digest, raw_size = encoded_value
+            if codec == "zlib":
+                entry.pop("cpu")
+            entry["decoded_sha256"] = decoded_sha256
+            encoded_hasher.update(entry["layer_name"].encode())
+            encoded_hasher.update(encoded_digest)
+            decoded_hasher.update(entry["layer_name"].encode())
+            decoded_hasher.update(bytes.fromhex(decoded_sha256))
+            raw_bytes += raw_size
+            encoded_bytes += raw_size if encoded is None else len(encoded)
+            entry["encoded"] = encoded
+        stores[pin_key] = {"codec": codec, "entries": entries}
+        return {
+            "tensor_parallel_rank": get_tp_group().rank_in_group,
+            "pipeline_parallel_rank": get_pp_group().rank_in_group,
+            "operation_drained": True,
+            "encoded_sha256": encoded_hasher.hexdigest(),
+            "decoded_sha256": decoded_hasher.hexdigest(),
+            "raw_bytes": raw_bytes,
+            "encoded_bytes": encoded_bytes,
+            "offload_ms": (time.perf_counter_ns() - started) / 1e6,
+            "destructive": destructive,
+        }
+
+    def retire_restore_blocks(
+        self, pin_key: str, group_block_ids: list[list[int]]
+    ) -> dict[str, Any]:
+        """Decode worker-local DRAM pages back into their pinned GPU slots."""
+        import os
+        import hashlib
+        import time
+        import zlib
+        from concurrent.futures import ThreadPoolExecutor
+
+        stores = getattr(self, "_retire_dram_stores", {})
+        store = stores.get(pin_key)
+        if store is None:
+            raise KeyError(f"unknown RETIRE DRAM object: {pin_key}")
+        targets = self._retire_cache_slices(group_block_ids)
+        entries = store["entries"]
+        if len(entries) != len(targets):
+            raise RuntimeError("RETIRE DRAM object does not match active KV layers")
+        started = time.perf_counter_ns()
+        restored = 0
+        remapped_blocks = 0
+        integrity_verified = True
+
+        def decode(entry: dict[str, Any]) -> tuple[Any, bool]:
+            encoded = entry["encoded"]
+            if store["codec"] == "identity":
+                cpu = entry["cpu"]
+                raw = memoryview(cpu.view(torch.uint8).numpy())
+                return (
+                    cpu,
+                    hashlib.sha256(raw).hexdigest()
+                    == entry["decoded_sha256"],
+                )
+            raw = zlib.decompress(encoded)
+            return (
+                raw,
+                hashlib.sha256(raw).hexdigest() == entry["decoded_sha256"],
+            )
+
+        workers = min(len(entries), 16, max(1, os.cpu_count() or 1))
+        with ThreadPoolExecutor(max_workers=workers) as executor:
+            decoded_entries = list(executor.map(decode, entries))
+        with torch.no_grad():
+            for item, target, (decoded, verified) in zip(
+                entries, targets, decoded_entries, strict=True
+            ):
+                integrity_verified &= verified
+                source = (
+                    decoded
+                    if store["codec"] == "identity"
+                    else torch.frombuffer(
+                        bytearray(decoded), dtype=item["dtype"]
+                    ).reshape(item["shape"])
+                )
+                if all(
+                    physical in item["physical_ids"]
+                    for physical in target["physical_ids"]
+                ):
+                    positions = [
+                        item["physical_ids"].index(physical)
+                        for physical in target["physical_ids"]
+                    ]
+                else:
+                    # Capacity-reclaiming offload deliberately releases the
+                    # old slots.  Fresh block IDs preserve prefix order, not
+                    # physical identity with the source allocation.
+                    positions = list(range(len(target["physical_ids"])))
+                    remapped_blocks += len(positions)
+                if positions == list(range(len(positions))):
+                    source = source.narrow(
+                        item["block_axis"], 0, len(positions)
+                    )
+                else:
+                    position_tensor = torch.tensor(
+                        positions, dtype=torch.long
+                    )
+                    source = torch.index_select(
+                        source, item["block_axis"], position_tensor
+                    )
+                if not source.is_pinned():
+                    source = source.pin_memory()
+                cache = target["cache"]
+                ids = torch.tensor(
+                    target["physical_ids"], dtype=torch.long, device=cache.device
+                )
+                cache.index_copy_(
+                    target["block_axis"],
+                    ids,
+                    source.to(cache.device, non_blocking=True),
+                )
+                restored += source.numel() * source.element_size()
+        torch.cuda.current_stream(self.device).synchronize()
+        return {
+            "tensor_parallel_rank": get_tp_group().rank_in_group,
+            "pipeline_parallel_rank": get_pp_group().rank_in_group,
+            "operation_drained": True,
+            "integrity_verified": integrity_verified,
+            "restored_bytes": restored,
+            "remapped_blocks": remapped_blocks,
+            "restore_ms": (time.perf_counter_ns() - started) / 1e6,
+        }
+
+    def retire_drop_dram(self, pin_key: str) -> bool:
+        """Drop one worker-local encoded DRAM object after reclaim."""
+        return getattr(self, "_retire_dram_stores", {}).pop(pin_key, None) is not None
+
     def compile_or_warm_up_model(self) -> None:
         warmup_sizes = []

