+                    raise RuntimeError(
+                        "RETIRE observed an inconsistent KV-group topology"
+                    )
+                physical_groups = [
+                    [block for block in group if not block.is_null]
+                    for group in computed_groups
+                ]
+                all_resident = (
+                    cached_tokens > 0
+                    and all(computed_groups)
+                    and all(physical_groups)
+                )
+                if all_resident:
+                    manager.block_pool.touch(tuple(physical_groups))
+                    group_block_ids = [
+                        [block.block_id for block in group]
+                        for group in computed_groups
+                    ]
+                    physical_group_block_ids = [
+                        [block.block_id for block in group]
+                        for group in physical_groups
+                    ]
+                    group_tokens = [cached_tokens for _ in range(num_groups)]
+                else:
+                    group_block_ids = [[] for _ in range(num_groups)]
+                    physical_group_block_ids = [[] for _ in range(num_groups)]
+                    group_tokens = [0 for _ in range(num_groups)]
